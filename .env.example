PORT=3001
ADMIN_PASSWORD=use-a-private-password-at-least-12-characters
ADMIN_TOKEN_SECRET=generate-at-least-32-random-characters
DATABASE_PATH=server/data/challenge.sqlite
# For local Vite development; production uses same-origin requests by default.
CLIENT_ORIGIN=http://localhost:5173
# Vercel production only: create a Neon Postgres database and set its pooled connection URL.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
